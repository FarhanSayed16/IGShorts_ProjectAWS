{
  "name": "igshorts-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.17.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @igshorts/web --filter @igshorts/api dev",
    "dev:web": "pnpm --filter @igshorts/web dev",
    "dev:api": "pnpm --filter @igshorts/api dev",
    "build": "pnpm --filter @igshorts/shared build && pnpm --filter @igshorts/db build && pnpm --filter @igshorts/infra build && pnpm --parallel --filter @igshorts/api --filter @igshorts/web build",
    "build:shared": "pnpm --filter @igshorts/shared build",
    "build:db": "pnpm --filter @igshorts/db build",
    "build:api": "pnpm --filter @igshorts/api build",
    "build:web": "pnpm --filter @igshorts/web build",
    "build:infra": "pnpm --filter @igshorts/infra build",
    "cdk:synth": "pnpm --filter @igshorts/infra synth",
    "cdk:diff": "pnpm --filter @igshorts/infra diff",
    "cdk:deploy": "pnpm --filter @igshorts/infra deploy",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "test": "pnpm --recursive run test",
    "db:generate": "pnpm --filter @igshorts/db generate",
    "db:migrate": "pnpm --filter @igshorts/db migrate",
    "seed:import": "pnpm --filter @igshorts/api seed:import",
    "seed:audit": "pnpm --filter @igshorts/api seed:audit",
    "job:pipeline": "pnpm --filter @igshorts/api job:pipeline",
    "clean": "pnpm --recursive run clean"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
