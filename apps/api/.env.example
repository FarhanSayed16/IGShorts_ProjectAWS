# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://igshorts:igshorts_dev_password@localhost:5432/igshorts_db?schema=public

# Ingestion Provider (seed | meta)
PROVIDER=seed

# AWS (ap-south-1)
AWS_REGION=ap-south-1
S3_BUCKET_IMPORTS=igshorts-imports-dev

# Security & Admin
# Generate a long random string. Required for login tokens.
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
# Optional machine-to-machine key. Leave empty to disable API-key auth.
ADMIN_API_KEY=
# Creates the first admin only when the admin_users table is empty.
ADMIN_BOOTSTRAP_EMAIL=admin@localhost
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
# Optional EventBridge / cron caller secret for POST /api/v1/internal/jobs/daily
JOBS_SECRET=
CRON_ENABLED=false
RATE_LIMIT_MAX=120
