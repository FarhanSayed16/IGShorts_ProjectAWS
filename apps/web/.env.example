# Frontend Configuration
# Local: copy to .env.local. Browser calls this origin (CORS allows localhost:3000).
# If unset, the app uses same-origin /api/v1 and next dev proxies it to the Nest API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side fetch inside Docker/ECS (browser still uses NEXT_PUBLIC_API_URL or /api/v1)
API_INTERNAL_URL=http://localhost:4000/api/v1
