@startuml IGshorts_AWS_Deployment
title IGshorts — AWS Staging Stack (CDK, ap-south-1)

skinparam backgroundColor #F7F9FC
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam defaultFontColor #1F2937
skinparam roundCorner 12
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.4
skinparam ArrowFontColor #475569
skinparam ArrowFontSize 10
skinparam packageStyle rectangle
skinparam packageBorderColor #94A3B8
skinparam packageFontColor #0F172A
skinparam packageFontStyle bold
skinparam rectangleBorderColor #94A3B8
skinparam databaseBorderColor #0EA5E9
skinparam noteBackgroundColor #EFF6FF
skinparam noteBorderColor #3B82F6
skinparam noteFontColor #1E3A8A
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #E2E8F0

actor "Public users / editors" as U #FEF3C7

package "AWS Region ap-south-1" as Region #F8FAFC {

  package "Edge" as Edge #EEF2FF {
    rectangle "**Application Load Balancer**\nHTTP :80 · HTTPS :443 if ACM ARN set\npath: / → web · /api/* → API" as ALB #C7D2FE
    rectangle "**AWS WAF**\nrate limit · common rule set" as WAF #A5B4FC
  }

  package "Compute (ECS Fargate)" as Compute #F0FDF4 {
    rectangle "**Web task**\nNext.js standalone\nport 3000" as WebApp #DCFCE7
    rectangle "**API task**\nNestJS Fastify\nport 4000" as ApiApp #BBF7D0
    rectangle "**Pipeline task**\nEventBridge 02:00 UTC\nnode apps/api/dist/scripts/run-pipeline.js" as Workers #86EFAC
  }

  package "Data (private / isolated subnets)" as DataTier #FDF2F8 {
    database "**RDS PostgreSQL 16**\nSecrets Manager credentials" as RDS #FCE7F3
    rectangle "**S3 imports bucket**\nseed files · private" as S3 #F9A8D4
  }

  package "Security" as Sec #FFF7ED {
    rectangle "**Secrets Manager**\nJWT · API key · jobs secret · DB" as SM #FFEDD5
    rectangle "**VPC**\npublic / compute / isolated DB" as VPC #FDBA74
  }

  package "Observability" as Obs #ECFEFF {
    rectangle "**CloudWatch**\nlogs · EMF JobFailed / freshness" as CW #CFFAFE
    rectangle "**SNS alerts**\n5xx · failed job · stale ranks" as SNS #A5F3FC
  }
}

cloud "CI" as Ext #F1F5F9 {
  rectangle "**GitHub Actions**\npnpm 11.17 · CDK asset deploy" as GH #CBD5E1
}

U --> WAF
WAF --> ALB
ALB --> WebApp
ALB --> ApiApp
WebApp --> ApiApp : SSR uses API_INTERNAL_URL
ApiApp --> RDS
ApiApp --> S3
ApiApp --> SM
Workers --> RDS
Workers --> SM
WebApp --> CW
ApiApp --> CW
Workers --> CW
CW --> SNS
GH --> WebApp : cdk fromAsset repo root
GH --> ApiApp : cdk fromAsset repo root
GH --> Workers : same API image

note right of ALB
  HTTPS requires context
  **certificateArn**.
  Without it, staging is HTTP-only.
end note

note bottom of RDS
  API builds Prisma URL from
  **host / username / password / dbname**
  secret fields (not DATABASE_URL key).
end note

legend right
  |= Color |= Area |
  | <#C7D2FE> | Edge |
  | <#DCFCE7> | Compute |
  | <#FCE7F3> | Data |
  | <#FFEDD5> | Security |
  | <#CFFAFE> | Observability |
endlegend

@enduml
